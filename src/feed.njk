---
permalink: "feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.title }}</title>
    <description>{{ site.description }}</description>
    <link>{{ site.url if site.url else "/" }}</link>

    {% for post in collections.posts %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <description><![CDATA[{{ post.templateContent | safe }}]]></description>
      <link>{{ (site.url ~ post.url) if site.url else post.url }}</link>
      <guid>{{ (site.url ~ post.url) if site.url else post.url }}</guid>
      <pubDate>{{ post.date | rfc822Date }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>
